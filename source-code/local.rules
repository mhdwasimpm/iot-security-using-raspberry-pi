# Custom Snort Rules Used in the Project

# Detect Nmap SYN Scan Activity

alert tcp any any -> $HOME_NET any (msg:"Nmap SYN Scan Detected"; flags:S; sid:1000001; rev:1;)

# Detect ICMP Flood Attack

alert icmp any any -> $HOME_NET any (msg:"ICMP Flood Detected"; sid:1000002; rev:1;)

# Detect SSH Brute Force Attempts

alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; sid:1000003; rev:1;)

# Detect HTTP Flood Attempts

alert tcp any any -> $HOME_NET 80 (msg:"HTTP Flood Attempt"; sid:1000004; rev:1;)

# Monitor Access to Camera Login Page

alert tcp any any -> $HOME_NET 5000 (msg:"Camera Login Page Access"; sid:1000005; rev:1;)
